# clicklog — CLUSTER env template (k3s namespace `clicklog`).
#
# Copy to .env.k8s and fill in. .env.k8s is NEVER committed: this repo is
# public, so only this template ships. k8s/render-config.sh reads .env.k8s and
# writes k8s/00-config.yaml (a ConfigMap + Secret), which is git-ignored too.
#
# Container resources and published ports are absent on purpose — the k8s
# manifests express those, so CLICKHOUSE_MEM_LIMIT, *_BIND, *_EXT_PORT and
# friends have no meaning here. See .env.example for the Compose knobs.

# ── Valkey ──
# Read by the valkey Deployment's --maxmemory flag. Keep it under the
# container memory limit in k8s/20-valkey.yaml.
VK_MAXMEMORY="768mb"

# ── Ingest API (telemetry gateway) ──
# The gateway reads RUST_LOG; the Deployment maps this key onto it.
INGEST_RUST_LOG="info"

# ── Admin dashboard auth (JWT + single seeded admin) ──
# JWT_SECRET empty disables /v1/admin/login. Render puts these in the Secret.
JWT_SECRET=""
JWT_TTL_HOURS="24"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Deploy-time substitutions (NOT app config) ───────────────────────────────
# The manifests in k8s/ are committed with __REGISTRY__, __TAG__ and __TAILNET__
# placeholders so the repo carries no one installation's addresses. deploy.sh
# substitutes these into k8s/.rendered/ and applies from there; render-config.sh
# keeps them OUT of the ConfigMap, because no pod reads them.
REGISTRY_HOST="registry.<your-tailnet>.ts.net"
TAILNET="<your-tailnet>.ts.net"

# ── Ingest API keys (reference — consumed by the APPS, not this stack) ────────
# Each app sets TELEMETRY_INGEST_URL + the matching key; the gateway is the only
# door to ClickHouse. Keys are shown once at mint — record them here so they are
# not lost. Rotate/revoke in the dashboard, or DELETE /v1/admin/keys/{id}.
# render-config.sh deliberately keeps these OUT of the cluster: no clicklog pod
# has any use for them. Keep them equal to what each app actually sends, or the
# record is worse than none.
KEEPERPROXY_INGEST_KEY=""
BODHISTREAMS_INGEST_KEY=""
PIUMAVAULT_INGEST_KEY=""
